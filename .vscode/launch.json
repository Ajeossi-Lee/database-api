{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "APP_ENV": "dev"
      },
      "envFile": "${workspaceFolder}/.env.dev"
    }
  ]
}
