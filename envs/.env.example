# 环境文件模板，不含真实密钥。复制为 envs/.env.dev 后填写。
# 启动：APP_ENV=dev
APP_ENV=dev

# 应用
PROJECT_NAME="Database API"
API_V1_STR=/api/v1
DEBUG=True

# 数据库。异步引擎要求驱动写成 postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database_api
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# 慢查询阈值（毫秒）
LOG_MIN_DURATION_STATEMENT=1000

# 安全。JWT_SECRET_KEY 必须换成随机字符串
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# 刷新令牌有效期（分钟），120 即 2 小时
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=120
JWT_ISSUER=database-api
JWT_AUDIENCE=database-api-users

# 认证
AUTH_ENABLED=True
AUTH_DEFAULT_MODE=required

# 跨域
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# 允许的 Host。部署时改成实际域名
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# 日志
LOG_LEVEL=DEBUG


# 限流。RATE_LIMIT_ENABLED=False 时不限制请求频率
RATE_LIMIT_ENABLED=False
RATE_LIMIT=1000/minute
